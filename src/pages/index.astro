---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>COMP4020 prototype</title>
    <meta name="description" content="Descent: a dungeon prototype." />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <div class="page">
      <header>
        <nav aria-label="Primary">
          <a href="./">Home</a>
        </nav>
      </header>
      <main>
        <h1>Descent</h1>
        <div class="game-frame">
          <div id="game-root" aria-label="dungeon"></div>
        </div>
        <p id="dialogue" hidden></p>
        <p id="outcome" role="status" aria-live="polite"></p>
      </main>
      <footer>
        <p>COMP4020 crit prototype</p>
      </footer>
    </div>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
